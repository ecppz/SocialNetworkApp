@using Domain.Common.Enums
@model IEnumerable<PostDisplayViewModel>
@{
    ViewData["Title"] = "Home";
    Layout = "_LayoutUser";
    var currentUserId = (Guid)ViewBag.CurrentUserId;
}

<link rel="stylesheet" href="~/styles/views/home.css" asp-append-version="true" />

<div class="feed-container">
    <!-- COMPOSER -->
    <section class="card composer">
        <div class="composer-body">
            <img src="@(ViewBag.CurrentUserProfile ?? "/images/default-avatar.png")" width="45" height="45" class="avatar" />
            <a asp-controller="Post" asp-action="Create" class="btn-create-placeholder">¿Qué estás pensando hoy?</a>
        </div>
    </section>

    @foreach (var post in Model.OrderByDescending(p => p.CreatedAt))
    {
        <article class="card post-article">
            <header class="post-header">
                <img src="@(post.ProfileImage ?? "/images/default-avatar.png")" width="42" height="42" class="avatar" />
                <div class="post-meta">
                    <span class="author-name">@post.UserName</span>
                    <span class="post-time">@post.CreatedAt.ToString("g")</span>
                </div>
                @if (post.UserId == currentUserId)
                {
                    <div class="dropdown">
                        <button class="more-btn"><span class="material-symbols-outlined">more_horiz</span></button>
                        <div class="dropdown-content">
                            <a asp-controller="Post" asp-action="Edit" asp-route-id="@post.Id">Editar</a>
                            <a asp-controller="Post" asp-action="Delete" asp-route-id="@post.Id" class="danger">Eliminar</a>
                        </div>
                    </div>
                }
            </header>

            <div class="post-content">
                @if (!string.IsNullOrEmpty(post.Content))
                {
                    <p class="post-body-text">@post.Content</p>
                }
            </div>

            @if (!string.IsNullOrEmpty(post.ImageFile))
            {
                <div class="post-media-wrapper">
                    <img src="@post.ImageFile" class="post-image" alt="Post media" />
                </div>
            }

            @if (!string.IsNullOrEmpty(post.YouTubeUrl))
            {
                <div style="padding: 15px;">
                    <div class="ratio ratio-16x9" style="border-radius:12px; overflow:hidden;">
                        <iframe src="@post.YouTubeUrl.Replace("watch?v=", "embed/")" allowfullscreen style="border:0;"></iframe>
                    </div>
                </div>
            }

            <div class="post-interactions">
                <form asp-controller="Reaction" asp-action="React" method="post" style="display:contents">
                    <input type="hidden" name="postId" value="@post.Id" />
                    <button type="submit" name="type" value="Like" class="interaction-btn @(post.Reactions.Any(r => r.UserId == currentUserId && r.Type == ReactionType.Like) ? "active" : "")">
                        <span class="material-symbols-outlined">thumb_up</span> @post.Reactions?.Count(r => r.Type == ReactionType.Like)
                    </button>
                    <button type="submit" name="type" value="Dislike" class="interaction-btn @(post.Reactions.Any(r => r.UserId == currentUserId && r.Type == ReactionType.Dislike) ? "active-dislike" : "")">
                        <span class="material-symbols-outlined">thumb_down</span> @post.Reactions?.Count(r => r.Type == ReactionType.Dislike)
                    </button>
                </form>
                <div class="interaction-btn"><span class="material-symbols-outlined">chat_bubble</span> @post.Comments.Count()</div>
            </div>

            <!-- COMMENTS SECTION -->
            <section class="comments-section">
                @foreach (var comment in post.Comments.Where(c => c.ReplyToCommentId == null))
                {
                    <div class="comment-entry">
                        <img src="@(comment.ProfileImage ?? "/images/default-avatar.png")" width="32" height="32" class="avatar" />
                        <div class="comment-data">
                            <div class="comment-bubble-wrapper">
                                <div class="comment-bubble">
                                    <span class="comment-author">@comment.UserName</span>
                                    <p class="comment-text">@comment.Text</p>
                                </div>
                                @if (comment.UserId == currentUserId)
                                {
                                    <div class="dropdown comment-options">
                                        <button class="more-btn"><span class="material-symbols-outlined">more_horiz</span></button>
                                        <div class="dropdown-content">
                                            @* AGREGADO: Editar Comentario *@
                                            <a asp-controller="Comment" asp-action="Edit" asp-route-id="@comment.Id">Editar</a>
                                            <a asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" class="danger">Eliminar</a>
                                        </div>
                                    </div>
                                }
                            </div>
                            <div class="comment-actions">
                                <span class="action-btn" onclick="toggleReply('@comment.Id')">Responder</span>
                                <span>· @comment.CreatedAt.ToString("t")</span>
                            </div>

                            <!-- REPLY FORM -->
                            <form id="reply-@comment.Id" asp-controller="Comment" asp-action="Reply" method="post" class="reply-form" style="display:none;">
                                <input type="hidden" name="postId" value="@post.Id" />
                                <input type="hidden" name="replyToCommentId" value="@comment.Id" />
                                <div class="input-container">
                                    <input type="text" name="text" class="comment-input-field" placeholder="Escribe una respuesta..." required />
                                    <button type="submit" class="inline-send-btn"><span class="material-symbols-outlined">send</span></button>
                                </div>
                            </form>

                            <!-- REPLIES -->
                            @foreach (var reply in comment.Replies)
                            {
                                <div class="comment-entry" style="margin-top:10px; padding-left:10px;">
                                    <img src="@(reply.ProfileImage ?? "/images/default-avatar.png")" width="24" height="24" class="avatar" />
                                    <div class="comment-data">
                                        <div class="comment-bubble-wrapper">
                                            <div class="comment-bubble">
                                                <span class="comment-author">@reply.UserName</span>
                                                <p class="comment-text">@reply.Text</p>
                                            </div>
                                            @if (reply.UserId == currentUserId)
                                            {
                                                <div class="dropdown comment-options">
                                                    <button class="more-btn"><span class="material-symbols-outlined">more_horiz</span></button>
                                                    <div class="dropdown-content">
                          
                                                        <a asp-controller="Comment" asp-action="Edit" asp-route-id="@reply.Id">Editar</a>
                                                        <a asp-controller="Comment" asp-action="Delete" asp-route-id="@reply.Id" class="danger">Eliminar</a>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }

                <!-- MAIN COMMENT INPUT -->
                <div class="main-comment-input">
                    <img src="@(ViewBag.CurrentUserProfile ?? "/images/default-avatar.png")" width="32" height="32" class="avatar" />
                    <form asp-controller="Comment" asp-action="AddComment" method="post" class="input-container">
                        <input type="hidden" name="postId" value="@post.Id" />
                        <input name="text" class="comment-input-field" placeholder="Escribe un comentario..." required />
                        <button type="submit" class="inline-send-btn"><span class="material-symbols-outlined">send</span></button>
                    </form>
                </div>
            </section>
        </article>
    }
</div>

<script>
    function toggleReply(id) {
        const form = document.getElementById('reply-' + id);
        form.style.display = form.style.display === 'none' ? 'flex' : 'none';
        if(form.style.display === 'flex') form.querySelector('input').focus();
    }
</script>