@model UpdateUserViewModel
@{
    ViewData["Title"] = "Configuración";
    Layout = "_LayoutUser";
}

<link rel="stylesheet" href="~/styles/views/profile.css" asp-append-version="true" />

<div class="profile-edit-container">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-7">
            
            <div class="profile-card">
                <div class="profile-header-gradient"></div>
                
                <div class="card-body p-4 p-md-5">
                    <form asp-controller="Profile" asp-action="Edit" method="POST" enctype="multipart/form-data">
                        <input type="hidden" asp-for="Id" />

                        <div class="avatar-upload-wrapper">
                            <img id="imgPreview" src="@Url.Content("~/" + Model.ProfileImage)" class="avatar-preview" />
                        </div>

                        <div class="text-center mb-5">
                            <h3 class="fw-bold m-0">@Model.Name @Model.LastName</h3>
                            <p class="text-muted small">Personaliza tu presencia en la red</p>
                        </div>

                        @if (ViewBag.HasError != null && ViewBag.HasError)
                        {
                            <div class="alert alert-danger border-0 rounded-3 mb-4">
                                @foreach (var error in ViewBag.Errors) { <p class="mb-0 small">@error</p> }
                            </div>
                        }

                        <div class="section-title">Información Básica</div>
                        
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Name" class="form-control" placeholder="Nombre" />
                                    <label asp-for="Name">Nombre</label>
                                </div>
                                <span asp-validation-for="Name" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="LastName" class="form-control" placeholder="Apellido" />
                                    <label asp-for="LastName">Apellido</label>
                                </div>
                                <span asp-validation-for="LastName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-12">
                                <div class="form-floating">
                                    <input asp-for="Phone" class="form-control" placeholder="Teléfono" />
                                    <label asp-for="Phone">Teléfono móvil</label>
                                </div>
                            </div>
                        </div>

                        <div class="section-title">Multimedia</div>
                        <div class="mb-4">
                            <label class="form-label small fw-bold">Actualizar foto de perfil</label>
                            <input type="file" asp-for="ProfileImageFile" class="form-control form-control-sm" id="fileInput" accept="image/*" />
                        </div>

                        <div class="section-title">Privacidad & Seguridad</div>
                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="password" asp-for="Password" class="form-control" placeholder="Nueva clave" />
                                    <label asp-for="Password">Nueva contraseña</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input type="password" asp-for="ConfirmPassword" class="form-control" placeholder="Confirmar" />
                                    <label asp-for="ConfirmPassword">Confirmar contraseña</label>
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between mt-5">
                            <a asp-controller="Home" asp-action="Index" class="btn-back text-decoration-none small">
                                <span class="material-symbols-outlined align-middle me-1">arrow_back</span> Volver al inicio
                            </a>
                            <button type="submit" class="btn btn-save d-flex align-items-center">
                                <span class="material-symbols-outlined me-2">check_circle</span> Guardar Perfil
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('fileInput').onchange = evt => {
            const [file] = document.getElementById('fileInput').files;
            if (file) {
                document.getElementById('imgPreview').src = URL.createObjectURL(file);
            }
        }
    </script>
}