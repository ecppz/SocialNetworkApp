@model FriendRequestDisplayViewModel
@{
    ViewData["Title"] = "Rechazar solicitud";
    Layout = "_LayoutUser";
}

<div class="col-12 col-md-6 offset-md-3">
    <div class="card shadow-sm">
        <div class="card-header bg-warning text-dark text-center">
            <h5>¿Está seguro que desea rechazar la solicitud de amistad del usuario <strong>@Model.UserName</strong>?</h5>
        </div>
        <div class="card-body text-center">
            <img src="@Url.Content(Model.ProfileImage.StartsWith("/") ? Model.ProfileImage : "/" + Model.ProfileImage)"
                 style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />
            <p class="text-muted">Amigos en común: @Model.MutualFriends</p>
        </div>
        <form asp-action="Reject" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-center gap-2 mb-3">
                <button type="submit" class="btn btn-warning">
                    <i class="bi bi-x-circle"></i> Rechazar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left-short"></i> Cancelar
                </a>
            </div>
        </form>
    </div>
</div>
