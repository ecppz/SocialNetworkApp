@model FriendRequestFormViewModel

@{
    ViewData["Title"] = "Enviar solicitud de amistad";
    Layout = "_LayoutUser";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1 text-dark">

                <i class="bi bi-person-plus-fill me-2"></i>
                Enviar solicitud

            </h2>

            <p class="text-muted mb-0">
                Busca usuarios y envía nuevas solicitudes de amistad.
            </p>

        </div>

    </div>

    <!-- BUSCADOR -->
    <div class="card border-0 shadow-sm mb-4 rounded-4">

        <div class="card-body p-4">

            <form method="get"
                  asp-action="Send">

                <div class="input-group">

                    <span class="input-group-text bg-white border-end-0 rounded-start-pill">
                        <i class="bi bi-search"></i>
                    </span>

                    <input type="text"
                           name="searchTerm"
                           class="form-control border-start-0"
                           placeholder="Buscar por username..."
                           value="@Model.SearchTerm" />

                    <button type="submit"
                            class="btn btn-dark rounded-end-pill px-4">

                        Buscar

                    </button>

                </div>

            </form>

        </div>

    </div>

    <!-- LISTA -->
    <form method="post"
          asp-action="Send">

        <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

            <div class="card-header bg-dark text-white p-3">

                <h5 class="mb-0">

                    <i class="bi bi-people-fill me-2"></i>
                    Usuarios disponibles

                </h5>

            </div>

            @if (Model.AvailableUsers.Any())
            {
                <div class="list-group list-group-flush">

                    @foreach (var user in Model.AvailableUsers)
                    {
                        <label class="list-group-item list-group-item-action p-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div class="d-flex align-items-center">

                                    <img src="@Url.Content(user.ProfileImage.StartsWith("/") ? user.ProfileImage : "/" + user.ProfileImage)"
                                         class="rounded-circle border me-3"
                                         width="55"
                                         height="55"
                                         style="object-fit: cover;" />

                                    <div>

                                        <div class="fw-semibold">
                                            <i class="bi bi-person-fill me-1 text-secondary"></i>
                                            @user.UserName
                                        </div>

                                        <small class="text-muted">

                                            <i class="bi bi-people me-1"></i>
                                            Amigos en común: @user.MutualFriends

                                        </small>

                                    </div>

                                </div>

                                <!-- RADIO -->
                                <input type="radio"
                                       name="receiverUserId"
                                       value="@user.Id"
                                       class="form-check-input fs-5"
                                       required />

                            </div>

                        </label>
                    }

                </div>
            }
            else
            {
                <div class="p-5 text-center text-muted">

                    <i class="bi bi-person-x fs-1 d-block mb-3"></i>

                    No hay usuarios disponibles.

                </div>
            }

            <!-- FOOTER -->
            <div class="card-footer bg-white border-0 p-4">

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                           class="btn btn-outline-secondary rounded-pill px-4">

                        <i class="bi bi-arrow-left me-1"></i>
                        Volver

                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-4 shadow-sm">

                        <i class="bi bi-send-fill me-1"></i>
                        Enviar solicitud

                    </button>

                </div>

            </div>

        </div>

    </form>

</div>