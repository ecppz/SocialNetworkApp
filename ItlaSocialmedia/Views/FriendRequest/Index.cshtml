@model FriendRequestListViewModel

@{
    ViewData["Title"] = "Solicitudes";
    Layout = "_LayoutUser";
}

<link rel="stylesheet" href="~/styles/views/friend-request-home.css" asp-append-version="true" />

<div class="feed-container">

    <!-- HEADER -->
    <header class="fr-header">
        <h2 class="fr-title">
            <span class="material-symbols-outlined">group_add</span>
            Solicitudes
        </h2>
        <a asp-action="Send" class="btn-modern fr-btn-primary">
            <span class="material-symbols-outlined">person_add</span>
            Enviar nueva
        </a>
    </header>

    <!-- ALERTAS -->
    @if (TempData["Message"] != null)
    {
        <div class="fr-alert fr-alert-@TempData["MessageType"]">
            <span>@TempData["Message"]</span>
            <button class="border-0 bg-transparent" onclick="this.parentElement.style.display='none';">&times;</button>
        </div>
    }

    <!-- SOLICITUDES RECIBIDAS -->
    <section class="fr-card">
        <div class="fr-card-header">
            <span class="material-symbols-outlined">inbox</span>
            Pendientes por aceptar
        </div>
        <div class="fr-card-body">
            @if (Model.ReceivedRequests.Any())
            {
                @foreach (var req in Model.ReceivedRequests)
                {
                    <div class="fr-list-item">
                        <div class="fr-list-content">
                            <img src="@(string.IsNullOrEmpty(req.ProfileImage) ? "/images/default-avatar.png" : req.ProfileImage)" class="fr-avatar" />
                            <div class="fr-user-info">
                                <span class="fr-username">@req.UserName</span>
                                <span class="fr-meta">@req.MutualFriends amigos en común</span>
                                <span class="fr-meta">Recibida: @req.CreatedAt.ToString("dd MMM")</span>
                            </div>
                        </div>
                        <div class="fr-actions">
                            <a asp-action="Accept" asp-route-id="@req.Id" class="btn-modern fr-btn-success">
                                <span class="material-symbols-outlined">done</span> Aceptar
                            </a>
                            <a asp-action="Reject" asp-route-id="@req.Id" class="btn-modern fr-btn-danger">
                                <span class="material-symbols-outlined">close</span>
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="fr-empty">
                    <span class="material-symbols-outlined">auto_awesome</span>
                    <p>¡Estás al día! No tienes solicitudes pendientes.</p>
                </div>
            }
        </div>
    </section>

    <!-- SOLICITUDES ENVIADAS -->
    <section class="fr-card">
        <div class="fr-card-header">
            <span class="material-symbols-outlined">near_me</span>
            Solicitudes enviadas
        </div>
        <div class="fr-card-body">
            @if (Model.SentRequests.Any())
            {
                @foreach (var req in Model.SentRequests)
                {
                    <div class="fr-list-item">
                        <div class="fr-list-content">
                            <img src="@(string.IsNullOrEmpty(req.ProfileImage) ? "/images/default-avatar.png" : req.ProfileImage)" class="fr-avatar" />
                            <div class="fr-user-info">
                                <span class="fr-username">@req.UserName</span>
                                <span class="fr-meta">Esperando respuesta...</span>
                                <span class="fr-badge">@req.Status</span>
                            </div>
                        </div>
                        <div class="fr-actions">
                            <a asp-action="Delete" asp-route-id="@req.Id" class="btn-modern fr-btn-danger">
                                <span class="material-symbols-outlined">delete</span> Cancelar
                            </a>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="fr-empty">
                    <span class="material-symbols-outlined">history</span>
                    <p>No has enviado solicitudes recientemente.</p>
                </div>
            }
        </div>
    </section>
</div>