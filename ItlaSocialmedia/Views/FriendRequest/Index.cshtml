@model FriendRequestListViewModel

@{
    ViewData["Title"] = "Solicitudes de amistad";
    Layout = "_LayoutUser";
}

<div class="container py-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold mb-1 text-dark">

                <i class="bi bi-people-fill me-2"></i>
                Solicitudes de amistad

            </h2>

            <p class="text-muted mb-0">
                Gestiona tus solicitudes recibidas y enviadas.
            </p>

        </div>

        <a asp-action="Send"
               class="btn btn-primary shadow-sm">

            <i class="bi bi-person-plus-fill me-1"></i>
            Nueva solicitud

        </a>

    </div>

    <!-- MENSAJE -->
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-@TempData["MessageType"] alert-dismissible fade show shadow-sm mb-4"
             role="alert">

            @TempData["Message"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>

        </div>
    }

    <!-- SOLICITUDES RECIBIDAS -->
    <div class="card border-0 shadow-sm mb-5">

        <div class="card-header bg-dark text-white p-3">

            <h5 class="mb-0">

                <i class="bi bi-envelope-fill me-2"></i>
                Solicitudes pendientes

            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.ReceivedRequests.Any())
            {
                <div class="list-group list-group-flush">

                    @foreach (var request in Model.ReceivedRequests)
                    {
                        <div class="list-group-item p-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div class="d-flex align-items-center">

                                    <img src="@request.ProfileImage"
                                         class="rounded-circle border me-3"
                                         width="60"
                                         height="60"
                                         style="object-fit: cover;" />

                                    <div>

                                        <div class="fw-semibold">
                                            @request.UserName
                                        </div>

                                        <small class="text-muted d-block">
                                            <i class="bi bi-people me-1"></i>
                                            Amigos en común: @request.MutualFriends
                                        </small>

                                        <small class="text-muted">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            @request.CreatedAt.ToString("dd/MM/yyyy")
                                        </small>

                                    </div>

                                </div>

                                <div class="d-flex gap-2">

                                    <a asp-action="Accept"
                                           asp-route-id="@request.Id"
                                           class="btn btn-success btn-sm">

                                        <i class="bi bi-check-lg me-1"></i>
                                        Aceptar

                                    </a>

                                    <a asp-action="Reject"
                                           asp-route-id="@request.Id"
                                           class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-x-lg me-1"></i>
                                        Rechazar

                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">

                    <i class="bi bi-inbox fs-1 d-block mb-2"></i>

                    No tienes solicitudes pendientes.

                </div>
            }

        </div>

    </div>

    <!-- SOLICITUDES ENVIADAS -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white p-3">

            <h5 class="mb-0">

                <i class="bi bi-send-fill me-2"></i>
                Solicitudes enviadas

            </h5>

        </div>

        <div class="card-body p-0">

            @if (Model.SentRequests.Any())
            {
                <div class="list-group list-group-flush">

                    @foreach (var request in Model.SentRequests)
                    {
                        <div class="list-group-item p-3">

                            <div class="d-flex justify-content-between align-items-center">

                                <div class="d-flex align-items-center">

                                    <img src="@request.ProfileImage"
                                         class="rounded-circle border me-3"
                                         width="60"
                                         height="60"
                                         style="object-fit: cover;" />

                                    <div>

                                        <div class="fw-semibold">
                                            @request.UserName
                                        </div>

                                        <small class="text-muted d-block">
                                            <i class="bi bi-people me-1"></i>
                                            Amigos en común: @request.MutualFriends
                                        </small>

                                        <small class="text-muted d-block">
                                            <i class="bi bi-calendar-event me-1"></i>
                                            @request.CreatedAt.ToString("dd/MM/yyyy")
                                        </small>

                                        <span class="badge bg-secondary mt-1">
                                            @request.Status
                                        </span>

                                    </div>

                                </div>

                                <div>

                                    <a asp-action="Delete"
                                           asp-route-id="@request.Id"
                                           class="btn btn-outline-danger btn-sm">

                                        <i class="bi bi-trash-fill me-1"></i>
                                        Eliminar

                                    </a>

                                </div>

                            </div>

                        </div>
                    }

                </div>
            }
            else
            {
                <div class="p-4 text-center text-muted">

                    <i class="bi bi-send-x fs-1 d-block mb-2"></i>

                    No has enviado solicitudes.

                </div>
            }

        </div>

    </div>

</div>