<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITLA SocialMedia</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <link rel="stylesheet" href="~/ItlaSocialmedia.styles.css" asp-append-version="true" />
</head>

<body>

    <header>

        <nav class="navbar navbar-expand-sm navbar-dark bg-black border-bottom border-secondary shadow-sm mb-3">

            <div class="container-fluid">

                <a class="navbar-brand fw-bold d-flex align-items-center gap-2 text-white"
                       asp-controller="Home"
                       asp-action="Index">
                    ITLA SocialMedia

                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target=".navbar-collapse">

                    <span class="navbar-toggler-icon"></span>

                </button>

                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">

                    <ul class="navbar-nav flex-grow-1 gap-1">

                        <li class="nav-item">
                            <a class="nav-link text-light d-flex align-items-center gap-2"
                                   asp-controller="Home"
                                   asp-action="Index">
                                <i class="bi bi-house-door-fill"></i>Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light d-flex align-items-center gap-2"
                                   asp-controller="Friend"
                                   asp-action="Index">
                                <i class="bi bi-people-fill"></i>Amigos
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light d-flex align-items-center gap-2"
                                   asp-controller="FriendRequest"
                                   asp-action="Index">
                                <i class="bi bi-person-plus-fill"></i>Solicitudes
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light d-flex align-items-center gap-2"
                                   asp-controller="Battleship"
                                   asp-action="Index">
                                <i class="bi bi-controller"></i>Battleship
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-light d-flex align-items-center gap-2"
                                   asp-controller="Profile"
                                   asp-action="Edit">
                                <i class="bi bi-person-circle"></i>Mi Perfil
                            </a>
                        </li>

                    </ul>

                    <ul class="navbar-nav">

                        <li class="nav-item">
                            <a class="nav-link text-danger d-flex align-items-center gap-2"
                                   asp-controller="Login"
                                   asp-action="Logout">
                                <i class="bi bi-box-arrow-right"></i>Logout (@User.Identity?.Name)
                            </a>
                        </li>

                    </ul>

                </div>

            </div>

        </nav>

    </header>

    <div class="container text-light">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top border-secondary footer text-light">
        <div class="container">
            &copy; @DateTime.Now.Year - Eric Pineda 2023-1475 - ItlaSocialmedia
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>