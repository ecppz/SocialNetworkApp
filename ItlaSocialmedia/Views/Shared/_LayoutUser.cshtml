@{
    ViewData["Title"] = ViewData["Title"] ?? "ITLA Social";
    Layout = null;
    string controller = ViewContext.RouteData.Values["Controller"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ITLA SocialNetwork</title>

    <!-- FUENTES -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700;800;900&display=swap" rel="stylesheet">

    <!-- ICONOS -->
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" />

    <!-- BOOTSTRAP & CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/styles/components/layout-user.css" asp-append-version="true" />
</head>
<body class="social-body">

    <div class="app-container">

        <!-- SIDEBAR -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <a asp-controller="Home" asp-action="Index" class="brand-box">
                    <span class="material-symbols-outlined">groups</span>
                    <h1 class="brand-name">ITLA Social Network</h1>
                </a>
            </div>

            <nav class="nav-list">
                <a asp-controller="Home" asp-action="Index" class="nav-item @(controller == "Home" ? "active" : "")">
                    <span class="material-symbols-outlined">home</span>
                    <span>Inicio</span>
                </a>

                <a asp-controller="Friend" asp-action="Index" class="nav-item @(controller == "Friend" ? "active" : "")">
                    <span class="material-symbols-outlined">group</span>
                    <span>Amigos</span>
                </a>

                <a asp-controller="FriendRequest" asp-action="Index" class="nav-item @(controller == "FriendRequest" ? "active" : "")">
                    <span class="material-symbols-outlined">person_add</span>
                    <span>Solicitudes</span>
                </a>

                <a asp-controller="Battleship" asp-action="Index" class="nav-item @(controller == "Battleship" ? "active" : "")">
                    <span class="material-symbols-outlined">sports_esports</span>
                    <span>Battleship</span>
                </a>

                <a asp-controller="Profile" asp-action="Edit" class="nav-item @(controller == "Profile" ? "active" : "")">
                    <span class="material-symbols-outlined">account_circle</span>
                    <span>Mi Perfil</span>
                </a>

                <a asp-controller="Login" asp-action="Logout" class="nav-item logout-item">
                    <span class="material-symbols-outlined">logout</span>
                    <span>Cerrar sesión</span>
                </a>
            </nav>
        </aside>

        <!-- MAIN CONTENT -->
        <main class="main-content">
            @RenderBody()
        </main>

    </div>

    <!-- MOBILE NAV (Solo visible en pantallas pequeñas) -->
    <nav class="mobile-nav">
        <a asp-controller="Home" asp-action="Index" class="mobile-nav-item @(controller == "Home" ? "active" : "")">
            <span class="material-symbols-outlined">home</span>
            <span>Inicio</span>
        </a>
        <a asp-controller="Friend" asp-action="Index" class="mobile-nav-item @(controller == "Friend" ? "active" : "")">
            <span class="material-symbols-outlined">group</span>
            <span>Amigos</span>
        </a>
        <a asp-controller="FriendRequest" asp-action="Index" class="mobile-nav-item @(controller == "FriendRequest" ? "active" : "")">
            <span class="material-symbols-outlined">notifications</span>
            <span>Alertas</span>
        </a>
        <a asp-controller="Login" asp-action="Logout" class="mobile-nav-item">
            <span class="material-symbols-outlined">logout</span>
            <span>Salir</span>
        </a>
    </nav>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>