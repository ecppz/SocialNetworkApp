<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - ITLA SocialMedia</title>

    <!-- GOOGLE FONTS -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Manrope:wght@700;800;900&display=swap"
          rel="stylesheet">

    <!-- MATERIAL ICONS -->
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
          rel="stylesheet">

    <!-- CUSTOM CSS -->
    <link rel="stylesheet" href="~/styles/components/layout-anonymous.css" />

</head>

<body>

    <!-- HEADER -->
    <header class="anonymous-header">

        <nav class="anonymous-navbar">

            <a class="brand-logo"
                   asp-controller="Login"
                   asp-action="Index">

                <span class="material-symbols-outlined">
                    groups
                </span>

                ITLA Social Network

            </a>

        </nav>

    </header>

    <!-- MAIN -->
    <main class="anonymous-main">
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer class="anonymous-footer">
        <span>© @DateTime.Now.Year ITLA SocialNetwork</span>
    </footer>

    <!-- SCRIPTS (ORDEN CORRECTO) -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- VALIDATION (CORRECTO PARA ASP.NET CORE) -->
    <partial name="_ValidationScriptsPartial" />

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>