@model RegisterUserViewModel
@{
    ViewData["Title"] = "Register User";
    Layout = "_LayoutAnonymous";
}

<div class="container d-flex justify-content-center align-items-center py-5">

    <div class="col-12 col-md-6">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-dark text-white text-center fw-bold">
                <i class="bi bi-person-plus-fill me-2"></i>Register
            </div>

            <div class="card-body p-4">

                @if (ViewBag.HasError != null && ViewBag.HasError)
                {
                    <div class="alert alert-danger">
                        @foreach (var error in ViewBag.Errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                <form asp-controller="Login" asp-action="Register" method="POST" enctype="multipart/form-data">

                    <div class="row">

                        <div class="col-md-6 mb-3">
                            <label asp-for="Name" class="form-label">Name</label>
                            <input class="form-control" asp-for="Name" />
                        </div>

                        <div class="col-md-6 mb-3">
                            <label asp-for="LastName" class="form-label">Last Name</label>
                            <input class="form-control" asp-for="LastName" />
                        </div>

                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">Email</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input class="form-control" asp-for="Email" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="UserName" class="form-label">Username</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person"></i></span>
                            <input class="form-control" asp-for="UserName" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" class="form-control" asp-for="Password" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="ConfirmPassword" class="form-label">Confirm Password</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                            <input type="password" class="form-control" asp-for="ConfirmPassword" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Phone" class="form-label">Phone</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                            <input class="form-control" asp-for="Phone" />
                        </div>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ProfileImageFile" class="form-label">Profile Image</label>
                        <input class="form-control" asp-for="ProfileImageFile" />
                    </div>

                    <div class="d-grid gap-2">

                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-floppy me-1"></i>Save
                        </button>

                        <a asp-controller="Login"
                               asp-action="Index"
                               class="btn btn-outline-dark">

                            <i class="bi bi-arrow-left me-1"></i>Back to login

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>