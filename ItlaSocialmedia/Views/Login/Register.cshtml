@model RegisterUserViewModel
@{
    ViewData["Title"] = "Registro";
    Layout = "_LayoutAnonymous";
}
<link rel="stylesheet" href="~/styles/views/register.css" asp-append-version="true" />

<div class="login-page">
    <div class="page-wrapper">
        <section class="branding-side">
            <div class="brand-content">
                <h1 class="brand-title">
                    Únete.<br />
                    Conecta.<br />
                    Crece.
                </h1>
                <p class="brand-tagline">
                    Comparte lo que piensas, descubre contenido nuevo y conecta sin límites.
                </p>
            </div>
        </section>

        <section class="form-side">
            <div class="login-container">
                <header class="form-header">
                    <h2>Crear cuenta</h2>
                    <p>Completa tus datos para registrarte</p>
                </header>

                @if (ViewBag.HasError != null && ViewBag.HasError)
                {
                    <div class="custom-validation">
                        @foreach (var error in ViewBag.Errors)
                        {
                            <div>@error</div>
                        }
                    </div>
                }

                <form asp-controller="Login" asp-action="Register" method="post" enctype="multipart/form-data">
                    <div class="form-group">
                        <input asp-for="Name" class="input-field" placeholder=" " />
                        <label class="input-label">Nombre</label>
                        <span asp-validation-for="Name" class="text-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="LastName" class="input-field" placeholder=" " />
                        <label class="input-label">Apellido</label>
                        <span asp-validation-for="LastName" class="text-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="Email" class="input-field" placeholder=" " />
                        <label class="input-label">Correo electrónico</label>
                        <span asp-validation-for="Email" class="text-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="UserName" class="input-field" placeholder=" " />
                        <label class="input-label">Usuario</label>
                        <span asp-validation-for="UserName" class="text-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="Password" type="password" class="input-field" placeholder=" " />
                        <label class="input-label">Contraseña</label>
                        <span asp-validation-for="Password" class="text-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="ConfirmPassword" type="password" class="input-field" placeholder=" " />
                        <label class="input-label">Confirmar contraseña</label>
                        <span asp-validation-for="ConfirmPassword" class="text-error"></span>
                    </div>

                    <div class="form-group">
                        <input asp-for="Phone" class="input-field" placeholder=" " />
                        <label class="input-label">Teléfono</label>
                        <span asp-validation-for="Phone" class="text-error"></span>
                    </div>

                    <div class="form-section">
                        <label class="section-label">
                            Foto de perfil
                        </label>
                        <div class="file-upload-card">
                            <input asp-for="ProfileImageFile" type="file" id="fileInput" accept="image/*" />
                            <label for="fileInput" class="file-upload-ui">
                                <i class="ph-bold ph-cloud-arrow-up"></i>
                                <div class="file-text">
                                    <strong>Sube tu imagen</strong>
                                    <span id="fileNamePath">PNG, JPG hasta 5MB</span>
                                </div>
                            </label>
                        </div>
                        <span asp-validation-for="ProfileImageFile" class="text-error"></span>
                    </div>

                    <div class="button-stack">
                        <button type="submit" class="btn-primary">
                            Crear cuenta
                        </button>
                        <div class="auth-footer">
                            <a asp-controller="Login" asp-action="Index">
                                Ya tengo cuenta
                            </a>
                        </div>
                    </div>
                </form>
            </div>
        </section>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('fileInput').onchange = evt => {
            const fileInput = document.getElementById('fileInput');
            const [file] = fileInput.files;
            const pathText = document.getElementById('fileNamePath');

            pathText.innerText = file ? file.name : "PNG, JPG hasta 5MB";
        }
    </script>
}