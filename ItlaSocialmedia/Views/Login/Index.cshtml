@model LoginViewModel
@{
    ViewData["Title"] = "Iniciar sesión";
    Layout = "_LayoutAnonymous";
}

<link rel="stylesheet"
      href="~/styles/views/login.css"
      asp-append-version="true" />

<div class="login-page">

    <div class="page-wrapper">

        <!-- BRAND SIDE -->
        <section class="branding-side">

            <div class="brand-content">

                <div class="brand-badge">
                </div>

                <h1 class="brand-title">
                    Comparte.<br />
                    Conecta.<br />
                    Descubre.
                </h1>
                <p class=".brand-tagline">Comparte lo que piensas, conecta y descubre contenido nuevo.</p>
            </div>

        </section>

        <!-- FORM SIDE -->
        <section class="form-side">

            <div class="login-container">

                <header class="form-header">

                    <h2>Bienvenido</h2>

                    <p>
                        Accede a tu cuenta para continuar
                    </p>

                </header>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="custom-validation">

                        @Html.ValidationSummary(false)

                    </div>
                }

                <form asp-controller="Login"
                      asp-action="Index"
                      method="post">

                    <!-- USERNAME -->
                    <div class="form-group">

                        <input asp-for="UserName"
                               class="input-field"
                               placeholder=" " />

                        <label asp-for="UserName"
                               class="input-label">

                            Correo electrónico o Usuario

                        </label>

                    </div>

                    <!-- PASSWORD -->
                    <div class="form-group">

                        <input asp-for="Password"
                               type="password"
                               class="input-field"
                               placeholder=" " />

                        <label asp-for="Password"
                               class="input-label">

                            Contraseña

                        </label>

                    </div>

                    <div class="button-stack">

                        <button type="submit"
                                class="btn-primary">
                            Iniciar sesión

                        </button>

                        <a asp-controller="Login"
                               asp-action="ForgotPassword"
                               class="forgot-link">

                            ¿Olvidaste tu contraseña?

                        </a>

                        <div class="separator"></div>

                        <a asp-controller="Login"
                               asp-action="Register"
                               class="btn-secondary">
                            Crear cuenta nueva

                        </a>

                    </div>

                </form>

            </div>

        </section>

    </div>

</div>