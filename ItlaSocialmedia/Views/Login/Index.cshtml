@model LoginViewModel
@{
    ViewData["Title"] = "Login Page";
    Layout = "_LayoutAnonymous";
}

<div class="container d-flex justify-content-center align-items-center" style="min-height:80vh;">

    <div class="col-12 col-md-4">

        <div class="card shadow-sm border-0">

            <div class="card-header bg-dark text-white text-center fw-bold">
                <i class="bi bi-box-arrow-in-right me-2"></i>Login
            </div>

            <div class="card-body p-4">

                @Html.ValidationSummary(false, "", new { @class = "text-danger mb-3" })

                <form asp-controller="Login" asp-action="Index" method="POST">

                    <div class="mb-3">

                        <label asp-for="UserName" class="form-label">Username</label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-person"></i>
                            </span>
                            <input class="form-control" asp-for="UserName" />
                        </div>

                    </div>

                    <div class="mb-3">

                        <label asp-for="Password" class="form-label">Password</label>

                        <div class="input-group">
                            <span class="input-group-text">
                                <i class="bi bi-lock"></i>
                            </span>
                            <input type="password" class="form-control" asp-for="Password" />
                        </div>

                    </div>

                    <div class="d-grid gap-2">

                        <button type="submit" class="btn btn-dark">
                            <i class="bi bi-door-open me-1"></i>Login
                        </button>

                        <a asp-controller="Login"
                               asp-action="Register"
                               class="btn btn-outline-dark">

                            <i class="bi bi-person-plus me-1"></i>Crear cuenta

                        </a>

                        <a asp-controller="Login"
                               asp-action="ForgotPassword"
                               class="text-center small text-muted">

                            ¿Olvidaste tu contraseña?

                        </a>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>