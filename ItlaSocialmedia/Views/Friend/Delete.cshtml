@model DeleteFriendViewModel
@{
    ViewData["Title"] = "eliminar amigo";
    Layout = "_LayoutUser";
}

<div class="col-12 col-md-6 offset-md-3">
    <div class="card shadow-sm">
        <div class="card-header bg-danger text-light text-center">
            <h5>¿Estás seguro de que deseas eliminar esta amistad??</h5>
        </div>
        <div class="card-body text-center">
            <img src="@Url.Content(Model.ProfileImage.StartsWith("/") ? Model.ProfileImage : "/" + Model.ProfileImage)"
                 style="width: 32px; height: 32px; border-radius: 50%; object-fit: cover;" />
            <h6 class="mb-1"><strong>@Model.UserName</strong></h6>
            <p class="text-muted">Amigos en común: @Model.MutualFriends</p>
        </div>

            <form asp-controller="Friend" asp-action="Delete" method="post">
                <input type="hidden" asp-for="Id" />
                <div class="d-flex justify-content-center gap-2 mt-3">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash"></i> Eliminar
                    </button>
                    <a asp-controller="Friend" asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left-short"></i> Cancelar
                    </a>
                </div>
            </form>
     </div>
</div>
