@using Domain.Common.Enums
@model FriendFeedViewModel
@{
    ViewData["Title"] = "Amigos";
    Layout = "_LayoutUser";
    var currentUserId = (Guid)ViewBag.CurrentUserId;
}

<div class="row">
    <div class="col-lg-8">
        <h2 class="mb-4 text-dark">Publicaciones de tus amigos</h2>

        @if (TempData["Message"] != null)
        {
            <div class="alert alert-@TempData["MessageType"]">
                @TempData["Message"]
            </div>
        }

        @foreach (var post in Model.Posts.OrderByDescending(p => p.CreatedAt))
        {
            <div class="card shadow-sm mb-4" style="border-radius: 12px;">
                <div class="card-header bg-light d-flex align-items-center" style="padding: 0.75rem 1rem;">
                    <div class="d-flex align-items-center" style="gap: 0.75rem;">
                        <div style="width: 48px; height: 48px; overflow: hidden; border-radius: 50%; flex-shrink: 0;">
                            <img src="@post.ProfileImage" alt="Foto de perfil"
                                 style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div>
                            <a asp-controller="Friend" asp-action="FriendProfile" asp-route-userName="@post.UserName">
                                <strong>@post.UserName</strong>
                            </a><br />
                            <small class="text-muted">@post.CreatedAt.ToString("g")</small>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <p class="mb-3">@post.Content</p>

                    @if (!string.IsNullOrEmpty(post.ImageFile))
                    {
                        <img src="@post.ImageFile" class="img-fluid rounded mb-3" alt="Imagen del post" />
                    }

                    @if (!string.IsNullOrEmpty(post.YouTubeUrl))
                    {
                        <div class="ratio ratio-16x9 mb-3">
                            <iframe src="@post.YouTubeUrl.Replace("watch?v=", "embed/")" allowfullscreen></iframe>
                        </div>
                    }

                    <div class="d-flex justify-content-between">
                        <div>
                            <span class="me-2 text-muted">
                                Likes @post.Reactions?.Count(r => r.Type == ReactionType.Like)
                            </span>
                            <span class="text-muted">
                                Dislikes @post.Reactions?.Count(r => r.Type == ReactionType.Dislike)
                            </span>
                        </div>
                        <form asp-controller="Reaction" asp-action="React" method="POST" class="d-flex gap-2">
                            <input type="hidden" name="postId" value="@post.Id" />
                            <button type="submit" name="type" value="Like"
                                    class="btn btn-sm @(post.CurrentUserReaction == ReactionType.Like ? "btn-success" : "btn-outline-success")">
                                Me gusta
                            </button>

                            <button type="submit" name="type" value="Dislike"
                                    class="btn btn-sm @(post.CurrentUserReaction == ReactionType.Dislike ? "btn-danger" : "btn-outline-danger")">
                                No me gusta
                            </button>
                        </form>
                    </div>

                    <form asp-controller="Comment" asp-action="AddComment" method="post" class="mt-3">
                        <input type="hidden" name="postId" value="@post.Id" />
                        <div class="input-group input-group-sm">
                            <input type="text" name="text" class="form-control" placeholder="Agregar comentario..." />
                            <button type="submit" class="btn btn-outline-primary">Comentar</button>
                        </div>
                    </form>

                    @if (post.Comments != null && post.Comments.Any())
                    {
                        <div class="mt-3">
                            @foreach (var comment in post.Comments.OrderBy(c => c.CreatedAt))
                            {
                                <div class="card mb-3 border-0 border-bottom pb-3">
                                    <div class="card-body p-0 d-flex gap-3">
                                        <img src="@comment.ProfileImage" class="rounded-circle" style="width: 40px; height: 40px; object-fit: cover;" />
                                        <div class="flex-grow-1">
                                            <div class="d-flex align-items-center gap-2">
                                                <strong>@comment.UserName</strong>
                                                <small class="text-muted">@comment.CreatedAt.ToString("g")</small>
                                            </div>
                                                <span>@comment.Text</span>
                                            @if ((Guid)ViewBag.CurrentUserId == comment.UserId)
                                            {
                                                <div class="mt-1 d-flex gap-2">
                                                    <form asp-controller="Comment" asp-action="Edit" method="get" style="display:inline;">
                                                        <input type="hidden" name="id" value="@comment.Id" />
                                                        <input type="hidden" name="isReply" value="false" />
                                                        <button type="submit" class="btn btn-sm btn-outline-warning">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                    </form>

                                                    <form asp-controller="Comment" asp-action="Delete" asp-route-id="@comment.Id" method="post" style="display:inline;">
                                                        <input type="hidden" name="isReply" value="false" />
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('estas seguro de que quieres eliminar este comentario?');">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>

                                                </div>
                                            }
                                            @if (comment.Replies != null && comment.Replies.Any())
                                            {
                                                <div class="mt-3 ms-4 border-start ps-3">
                                                    @foreach (var reply in comment.Replies.OrderBy(r => r.CreatedAt))
                                                    {
                                                        <div class="d-flex gap-2 mb-3">
                                                            <img src="@reply.ProfileImage" class="rounded-circle" style="width: 32px; height: 32px; object-fit: cover;" />
                                                            <div class="flex-grow-1">
                                                                <div class="d-flex align-items-center gap-2">
                                                                    <strong>@reply.UserName</strong>
                                                                    <small class="text-muted">@comment.CreatedAt.ToString("g")</small>
                                                                </div>
                                                                <span>@reply.Text</span>

                                                                @if ((Guid)ViewBag.CurrentUserId == reply.UserId)
                                                                {
                                                                    <div class="mt-1 d-flex gap-2">
                                                                        <form asp-controller="Comment" asp-action="Edit" method="get" style="display:inline;">
                                                                            <input type="hidden" name="id" value="@reply.Id" />
                                                                            <input type="hidden" name="isReply" value="true" />
                                                                            <button type="submit" class="btn btn-sm btn-outline-warning">
                                                                                <i class="bi bi-pencil-square"></i>
                                                                            </button>
                                                                        </form>

                                                                        <form asp-controller="Comment" asp-action="Delete" asp-route-id="@reply.Id" method="post" style="display:inline;">
                                                                            <input type="hidden" name="isReply" value="true" />
                                                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('estas seguro de que quieres eliminar esta respuesta?');">
                                                                                <i class="bi bi-trash"></i>
                                                                            </button>
                                                                        </form>

                                                                    </div>
                                                                }
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            <form asp-controller="Comment" asp-action="Reply" method="post" class="mt-2">
                                                <input type="hidden" name="postId" value="@post.Id" />
                                                <input type="hidden" name="replyToCommentId" value="@comment.Id" />
                                                <div class="input-group input-group-sm">
                                                    <input type="text" name="text" class="form-control" placeholder="Responder..." />
                                                    <button type="submit" class="btn btn-outline-secondary">Reply</button>
                                                </div>
                                            </form>
                                        </div>
                                    </div>
                                </div>


                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <h2 class="mb-4">Tus amigos</h2>

        @foreach (var friend in Model.Friends)
        {
            <div class="card shadow-sm mb-4" style="border-radius: 12px;">
                <div class="card-body d-flex align-items-center justify-content-between">
                    <div class="d-flex align-items-center" style="gap: 1rem;">
                        <div style="width: 64px; height: 64px; overflow: hidden; border-radius: 50%; flex-shrink: 0;">
                            <img src="@friend.ProfileImage" alt="Foto de perfil"
                                 style="width: 100%; height: 100%; object-fit: cover;" />
                        </div>
                        <div>
                            <a asp-controller="Friend" asp-action="FriendProfile" asp-route-userName="@friend.UserName">

                                <strong>@friend.UserName</strong>
                            </a>
                            <br />
                            <span class="text-muted">@friend.Name @friend.LastName</span>
                        </div>
                    </div>
                          <a asp-controller="Friend" asp-action="Delete" asp-route-id="@friend.Id">

                        <input type="hidden" name="Id" value="@friend.Id" />

                        <button type="submit" class="btn btn-outline-danger btn-sm">Eliminar amigo</button>
                        </a>
                </div>
            </div>
        }
    </div>
</div>
