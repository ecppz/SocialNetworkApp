@using Domain.Common.Enums
@model ShipViewModel

@{
    ViewData["Title"] = "Dirección del barco";
    Layout = "_LayoutUser";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-md-6 col-lg-5">

            @if (ViewBag.Message != null)
            {
                <div class="alert alert-primary alert-dismissible fade show shadow-sm mb-4"
                     role="alert">

                    @if (ViewBag.Message is string)
                    {
                        <div class="text-center text-dark">
                            @Html.Raw(ViewBag.Message.Replace("\n", "<br />"))
                        </div>
                    }
                    else
                    {
                        @foreach (var line in ViewBag.Message)
                        {
                            <p class="text-center text-dark mb-1">@line</p>
                        }
                    }

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="alert">
                    </button>

                </div>
            }

            <div class="card border-0 shadow-sm">

                <div class="card-header bg-dark text-white">

                    <h5 class="mb-0 text-white">
                        <i class="fa-solid fa-compass me-2"></i>
                        Dirección del barco
                    </h5>

                </div>

                <form asp-controller="Battleship"
                      asp-action="CreateShip"
                      method="post">

                    <input type="hidden" asp-for="Id" />
                    <input type="hidden" asp-for="GameId" />
                    <input type="hidden" asp-for="PlayerId" />
                    <input type="hidden" asp-for="Type" />
                    <input type="hidden" asp-for="Size" />
                    <input type="hidden" asp-for="StartX" />
                    <input type="hidden" asp-for="StartY" />
                    <input type="hidden" asp-for="IsSunk" />

                    <div class="card-body">

                        <label asp-for="Direction"
                               class="form-label fw-semibold text-dark">

                            Selecciona una dirección

                        </label>

                        <select class="form-select shadow-sm text-dark"
                                asp-for="Direction">

                            <option value="@Direction.Up">Arriba</option>
                            <option value="@Direction.Down">Abajo</option>
                            <option value="@Direction.Right">Derecha</option>
                            <option value="@Direction.Left">Izquierda</option>

                        </select>

                    </div>

                    <div class="card-footer bg-light text-end">

                        <a asp-controller="Battleship"
                               asp-action="ReturnToShipSelection"
                               asp-route-gameId="@Model.GameId"
                               asp-route-shipType="@((int)Model.Type)"
                               class="btn btn-outline-dark me-2">

                            <i class="fa-solid fa-arrow-left me-1"></i>
                            Volver

                        </a>

                        <button type="submit"
                                class="btn btn-dark">

                            <i class="fa-solid fa-check me-1"></i>
                            Posicionar

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>