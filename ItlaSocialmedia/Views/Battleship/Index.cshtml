@using System.Security.Claims
@model BattleshipGameHomeIndex

@{
    ViewData["Title"] = "Battleships";
    Layout = "_LayoutUser";

    string currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

<div class="container py-4">

    <!-- MENSAJES -->
    @if (ViewBag.Message != null)
    {
        if (ViewBag.Message is string)
        {
            <div class="alert alert-primary alert-dismissible fade show shadow-sm mb-4"
                 role="alert">

                <div class="text-center">
                    @Html.Raw(ViewBag.Message.Replace("\n", "<br />"))
                </div>

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }
        else
        {
            <div class="alert alert-primary alert-dismissible fade show shadow-sm mb-4"
                 role="alert">

                @foreach (var line in ViewBag.Message)
                {
                    <p class="text-center mb-1">@line</p>
                }

                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="alert">
                </button>

            </div>
        }
    }

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold mb-1 text-dark">
                <i class="bi bi-controller me-2"></i>
                Battleship
            </h2>

            <p class="text-muted mb-0">
                Gestiona tus partidas activas y revisa tu historial.
            </p>
        </div>

        <a class="btn btn-primary shadow-sm"
               asp-controller="Battleship"
               asp-action="Create">

            <i class="bi bi-plus-lg me-1"></i>
            Nueva partida

        </a>

    </div>

    <!-- RESUMEN -->
    <div class="row g-3 mb-4">

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-joystick fs-2 text-primary"></i>

                    <h6 class="mt-3 text-muted">
                        Partidas jugadas
                    </h6>

                    <h3 class="fw-bold">
                        @Model.Summary.GamesCount
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-trophy-fill fs-2 text-success"></i>

                    <h6 class="mt-3 text-muted">
                        Victorias
                    </h6>

                    <h3 class="fw-bold text-success">
                        @Model.Summary.GamesWinCount
                    </h3>

                </div>

            </div>

        </div>

        <div class="col-md-4">

            <div class="card border-0 shadow-sm h-100">

                <div class="card-body text-center">

                    <i class="bi bi-x-circle-fill fs-2 text-danger"></i>

                    <h6 class="mt-3 text-muted">
                        Derrotas
                    </h6>

                    <h3 class="fw-bold text-danger">
                        @Model.Summary.GamesLoseCount
                    </h3>

                </div>

            </div>

        </div>

    </div>

    <!-- PARTIDAS ACTIVAS -->
    <div class="card border-0 shadow-sm mb-5">

        <div class="card-header bg-dark text-white p-3">

            <h5 class="mb-0">
                <i class="bi bi-lightning-charge-fill me-2"></i>
                Partidas activas
            </h5>

        </div>

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Contrincante</th>
                        <th>Inicio</th>
                        <th>Duración</th>
                        <th class="text-center">Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.ActiveGames)
                    {
                        var duration = (item.EndDate ?? DateTime.Now) - item.StartDate;

                        <tr>

                            <td class="fw-semibold">
                                @(item.Player1Id.ToString() == currentUserId
                                    ? item.Player2!.UserName
                                    : item.Player1!.UserName)
                            </td>

                            <td>
                                @item.StartDate.ToShortDateString()
                            </td>

                            <td>
                                @($"{duration.Days}d {duration.Hours}h {duration.Minutes}m")
                            </td>

                            <td class="text-center">

                                <a class="btn btn-sm btn-outline-primary me-2"
                                       asp-controller="Battleship"
                                       asp-action="EnterTheGame"
                                       asp-route-gameId="@item.Id">

                                    <i class="bi bi-box-arrow-in-right me-1"></i>
                                    Entrar

                                </a>

                                <a class="btn btn-sm btn-outline-danger"
                                       asp-controller="Battleship"
                                       asp-action="GiveUpTheGame"
                                       asp-route-gameId="@item.Id"
                                       asp-route-userId="@currentUserId"
                                       asp-route-redirectToHome="true">

                                    <i class="bi bi-flag-fill me-1"></i>
                                    Rendirse

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

    <!-- HISTORIAL -->
    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white p-3">

            <h5 class="mb-0">

                <i class="bi bi-clock-history me-2"></i>
                Historial de partidas

            </h5>

        </div>

        <div class="table-responsive">

            <table class="table align-middle mb-0">

                <thead class="table-light">

                    <tr>
                        <th>Contrincante</th>
                        <th>Inicio</th>
                        <th>Finalización</th>
                        <th>Duración</th>
                        <th>Resultado</th>
                        <th>Ganador</th>
                        <th class="text-center">Acciones</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model.FinalizedGames)
                    {
                        var duration = (item.EndDate ?? DateTime.Now) - item.StartDate;

                        <tr>

                            <td class="fw-semibold">
                                @(item.Player1Id.ToString() == currentUserId
                                    ? item.Player2!.UserName
                                    : item.Player1!.UserName)
                            </td>

                            <td>
                                @item.StartDate.ToShortDateString()
                            </td>

                            <td>
                                @item.EndDate?.ToShortDateString()
                            </td>

                            <td>
                                @($"{duration.Days}d {duration.Hours}h {duration.Minutes}m")
                            </td>

                            <td>

                                @if (item.WinnerId.ToString() == currentUserId)
                                {
                                    <span class="badge bg-success">
                                        Victoria
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Derrota
                                    </span>
                                }

                            </td>

                            <td>

                                @(item.WinnerId.ToString() == currentUserId
                                    ? "Yo"
                                    : item.Player1Id.ToString() == currentUserId
                                        ? item.Player2!.UserName
                                        : item.Player1!.UserName)

                            </td>

                            <td class="text-center">

                                <a class="btn btn-sm btn-outline-primary"
                                       asp-controller="Battleship"
                                       asp-route-gameId="@item.Id"
                                       asp-route-userId="@currentUserId"
                                       asp-route-showOpponentBoard="false"
                                       asp-action="RedirectToAttackPreviewBoard">

                                    <i class="bi bi-eye-fill me-1"></i>
                                    Ver resultados

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>