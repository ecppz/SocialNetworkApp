@using System.Security.Claims
@model BattleshipGameHomeIndex

@{
    ViewData["Title"] = "Battleships";
    Layout = "_LayoutUser";
    string currentUserId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

<link rel="stylesheet" href="~/styles/views/battleship.css" asp-append-version="true" />

<div class="battleship-container">

    <!-- HEADER DE LA SECCIÓN -->
    <header class="main-header-card">
        <div class="header-info-box">
            <div class="header-icon-wrapper">
                <span class="material-symbols-outlined">stadia_controller</span>
            </div>
            <div>
                <h2 class="header-title">Battleship</h2>
                <p class="text-muted m-0 small">Combate naval estratégico</p>
            </div>
        </div>
        <a class="btn-modern btn-primary" asp-controller="Battleship" asp-action="Create">
            <span class="material-symbols-outlined">add_circle</span>
            Nueva partida
        </a>
    </header>

    <!-- RESUMEN DE ESTADÍSTICAS -->
    <div class="summary-grid">
        <div class="stat-card">
            <span class="material-symbols-outlined stat-icon text-primary">sports_esports</span>
            <div class="stat-label">Jugadas</div>
            <div class="stat-value">@Model.Summary.GamesCount</div>
        </div>
        <div class="stat-card">
            <span class="material-symbols-outlined stat-icon text-success">emoji_events</span>
            <div class="stat-label">Victorias</div>
            <div class="stat-value text-success">@Model.Summary.GamesWinCount</div>
        </div>
        <div class="stat-card">
            <span class="material-symbols-outlined stat-icon text-danger">skull</span>
            <div class="stat-label">Derrotas</div>
            <div class="stat-value text-danger">@Model.Summary.GamesLoseCount</div>
        </div>
    </div>

    <!-- PARTIDAS ACTIVAS -->
    <section class="section-card">
        <div class="section-header">
            <span class="material-symbols-outlined">bolt</span>
            Partidas en curso
        </div>
        <div class="section-body">
            @if (!Model.ActiveGames.Any())
            {
                <div class="empty-state">
                    <span class="material-symbols-outlined">smart_toy</span>
                    <p>No tienes batallas activas en este momento.</p>
                </div>
            }
            else
            {
                @foreach (var item in Model.ActiveGames)
                {
                    var opponent = item.Player1Id.ToString() == currentUserId ? item.Player2?.UserName : item.Player1?.UserName;
                    <div class="game-item">
                        <div class="opponent-info">
                            <span class="opponent-name">Vs. @opponent</span>
                            <span class="game-details">Iniciada el @item.StartDate.ToShortDateString()</span>
                        </div>
                        <div class="d-flex gap-2">
                            <a class="btn-modern btn-outline" asp-controller="Battleship" asp-action="EnterTheGame" asp-route-gameId="@item.Id">
                                <span class="material-symbols-outlined">play_arrow</span> Entrar
                            </a>
                            <a class="btn-modern btn-danger-outline" asp-controller="Battleship" asp-action="GiveUpTheGame" asp-route-gameId="@item.Id" asp-route-userId="@currentUserId" asp-route-redirectToHome="true">
                                <span class="material-symbols-outlined">flag</span>
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </section>

    <!-- HISTORIAL -->
    <section class="section-card">
        <div class="section-header">
            <span class="material-symbols-outlined">history</span>
            Historial de batalla
        </div>
        <div class="section-body">
            @if (!Model.FinalizedGames.Any())
            {
                <div class="empty-state">
                    <p>Tu historial de guerra está vacío.</p>
                </div>
            }
            else
            {
                @foreach (var item in Model.FinalizedGames)
                {
                    var opponent = item.Player1Id.ToString() == currentUserId ? item.Player2?.UserName : item.Player1?.UserName;
                    bool win = item.WinnerId.ToString() == currentUserId;
                    <div class="game-item">
                        <div class="opponent-info">
                            <span class="opponent-name">Vs. @opponent</span>
                            <div class="d-flex align-items:center gap-2 mt-1">
                                <span class="badge @(win ? "badge-win" : "badge-lose")">
                                    @(win ? "Victoria" : "Derrota")
                                </span>
                                <span class="game-details">@item.EndDate?.ToShortDateString()</span>
                            </div>
                        </div>
                        <a class="btn-modern btn-outline" asp-controller="Battleship" asp-route-gameId="@item.Id" asp-route-userId="@currentUserId" asp-route-showOpponentBoard="false" asp-action="RedirectToAttackPreviewBoard">
                            <span class="material-symbols-outlined">visibility</span>
                        </a>
                    </div>
                }
            }
        </div>
    </section>

</div>