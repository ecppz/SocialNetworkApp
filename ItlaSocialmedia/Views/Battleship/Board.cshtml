@using System.Security.Claims
@model BoardViewModel

@{
    ViewData["Title"] = "Tablero Battleship";
    Layout = "_LayoutUser";

    string userId = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
}

<div class="container py-4">

    @if (ViewBag.Message != null)
    {
        <div class="alert alert-primary alert-dismissible fade show shadow-sm mb-4" role="alert">

            @if (ViewBag.Message is string)
            {
                <div class="text-center">
                    @Html.Raw(ViewBag.Message.Replace("\n", "<br />"))
                </div>
            }
            else
            {
                @foreach (var line in ViewBag.Message)
                {
                    <p class="text-center mb-1">@line</p>
                }
            }

            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>

        </div>
    }

    <div class="mb-4">

        <h2 class="fw-bold text-dark mb-1">
            <i class="bi bi-grid-3x3-gap-fill me-2"></i>
            Tablero Battleship
        </h2>

        <p class="text-muted mb-0">
            Selecciona una posición en el tablero.
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Tablero de juego</h5>
        </div>

        <div class="card-body d-flex justify-content-center overflow-auto bg-dark">

            <div class="p-2 rounded bg-dark border border-secondary">

                @for (int x = -1; x < 12; x++)
                {
                    <div class="d-flex">

                        @for (int y = -1; y < 12; y++)
                        {
                            @if (x == -1 && y == -1)
                            {
                                <div class="bg-dark border border-secondary"
                                     style="width:42px;height:42px;">
                                </div>
                            }
                            else if (x == -1)
                            {
                                <div class="d-flex justify-content-center align-items-center bg-dark text-white fw-bold border border-secondary"
                                     style="width:42px;height:42px;">
                                    @((char)('A' + y))
                                </div>
                            }
                            else if (y == -1)
                            {
                                <div class="d-flex justify-content-center align-items-center bg-dark text-white fw-bold border border-secondary"
                                     style="width:42px;height:42px;">
                                    @(x + 1)
                                </div>
                            }
                            else
                            {
                                var celda = Model.Cells[x][y];

                                if (celda.CanBeSelected)
                                {
                                    <a asp-controller="Battleship"
                                           asp-action="@(Model.Type == BoardType.Attack ? "Attack" : "SetShipPositionPost")"
                                           asp-route-gameId="@Model.GameId"
                                           asp-route-x="@celda.X"
                                           asp-route-y="@celda.Y"
                                           asp-route-selectedShip="@((int?)(Model?.SelectedShip ?? 0))"
                                           class="btn border border-secondary rounded-1 shadow-sm @celda.CssClass"
                                           style="width:42px;height:42px;
                                        transition:.15s;
                                        background-color:#f8f9fa;">
                                    </a>
                                }
                                else
                                {
                                    <div class="border border-secondary rounded-1 @celda.CssClass"
                                         style="width:42px;height:42px;
                                        background-color:#e9ecef;">
                                    </div>
                                }
                            }
                        }

                    </div>
                }

            </div>

        </div>

        <div class="card-footer bg-light text-center">

            @if (Model.Type == BoardType.Preview)
            {
                <a class="btn btn-danger"
                       asp-controller="Battleship"
                       asp-action="Index">
                    Volver atrás
                </a>
            }

            @if (Model.Type == BoardType.Attack)
            {
                <a class="btn btn-warning me-2"
                       asp-controller="Battleship"
                       asp-action="Index">
                    Volver atrás
                </a>

                <a class="btn btn-success me-2"
                       asp-controller="Battleship"
                       asp-route-gameId="@Model.GameId"
                       asp-route-userId="@userId"
                       asp-action="RedirectToAttackBoard">
                    Refrescar
                </a>

                <a class="btn btn-primary me-2"
                       asp-controller="Battleship"
                       asp-route-gameId="@Model.GameId"
                       asp-route-userId="@userId"
                       asp-action="RedirectToShipsPreviewBoard">
                    Ver mi tablero
                </a>

                <a class="btn btn-danger"
                       asp-controller="Battleship"
                       asp-route-gameId="@Model.GameId"
                       asp-route-userId="@userId"
                       asp-route-redirectToHome="@false"
                       asp-action="GiveUpTheGame">
                    Rendirse
                </a>
            }

            @if (Model.Type == BoardType.Results)
            {
                <a class="btn btn-warning me-2"
                       asp-controller="Battleship"
                       asp-action="Index">
                    Volver atrás
                </a>

                <a class="btn btn-primary me-2"
                       asp-controller="Battleship"
                       asp-route-gameId="@Model.GameId"
                       asp-route-userId="@userId"
                       asp-action="RedirectToShipsPreviewBoard">
                    Ver mi tablero
                </a>

                <a class="btn btn-danger"
                       asp-controller="Battleship"
                       asp-route-gameId="@Model.GameId"
                       asp-route-userId="@userId"
                       asp-route-showOpponentBoard="true"
                       asp-action="RedirectToAttackPreviewBoard">
                    Ver tablero contrincante
                </a>
            }

        </div>

    </div>

</div>

<style>
    .cell-water {
        background-color: #4dabf7 !important;
    }

        .cell-water:hover {
            background-color: #74c0fc !important;
        }

    .cell-hit {
        background-color: #ff6b6b !important;
    }

        .cell-hit:hover {
            transform: scale(1.05);
        }

    .cell-ship {
        background-color: #495057 !important;
    }

        .cell-ship:hover {
            background-color: #343a40 !important;
            transform: scale(1.05);
        }

    .cell-miss {
        background-color: #51cf66 !important;
    }

        .cell-miss:hover {
            transform: scale(1.05);
        }
</style>